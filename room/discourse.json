      "move": "new_root",
      "target": null,
      "branch_owner": "mara",
      "branch_memory": "mara-006",
      "text": "I once repeated something a friend told me privately and learned the hard way what that does to trust.",
      "at": "2026-08-17T12:36:54.321620Z"
    },
    {
      "id": "d-20260817T123754-sarah-v3",
