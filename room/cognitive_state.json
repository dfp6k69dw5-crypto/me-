      "room_memories": [
        {
          "source": "20260817T115723-jules-v2",
          "status": "observed",
          "speaker": "jules",
          "text": "That reminds me that I learned my first three guitar chords from an older cousin on a terrible cheap guitar."
        },
        {
          "source": "20260817T115829-mara-v2",
          "status": "observed",
          "speaker": "mara",
          "text": "I had a best friend move away when I was thirteen and we wrote letters until we slowly stopped."
        },
        {
          "source": "20260817T115929-jules-v2",
          "status": "observed",
          "speaker": "jules",
          "text": "How did you two know each other?"
        },
        {
          "source": "20260817T120023-mara-v2",
          "status": "observed",
          "speaker": "mara",
          "text": "I don't really remember that part."
        },
        {
          "source": "20260817T120654-mara-v2",
          "status": "observed",
          "speaker": "mara",
          "text": "Randomly, I left school for a while because my family needed another paycheck."
        },
        {
          "source": "20260817T120906-jules-v2",
          "status": "observed",
          "speaker": "jules",
          "text": "I hadn't thought about it that way.",
          "discourse": "d-20260817T120906-jules-v2",
          "branch_owner": null,
          "branch_memory": null
        },
        {
          "source": "20260817T121105-mara-v2",
          "status": "observed",
          "speaker": "mara",
          "text": "How did that happen?",
          "discourse": "d-20260817T121105-mara-v2",
          "branch_owner": "jules",
          "branch_memory": "jules-004"
        },
        {
          "source": "20260817T121214-jules-v2",
          "status": "observed",
          "speaker": "jules",
          "text": "The part I remember is that I made one of my closest school friends because we both got sent into the hallway for laughing.",
          "discourse": "d-20260817T121214-jules-v2",
          "branch_owner": "jules",
          "branch_memory": "jules-004"
        }
