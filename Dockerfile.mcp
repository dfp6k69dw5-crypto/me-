FROM python:3.12-slim

WORKDIR /app

COPY requirements-mcp.txt ./
RUN pip install --no-cache-dir -r requirements-mcp.txt

COPY mcp_server.py remote_mcp_server.py ./
COPY scripts ./scripts
COPY cluster ./cluster

ENV PYTHONUNBUFFERED=1
ENV SIMULATOR_RUN_DIR=/tmp/alex-repo-simulator-runs
ENV PORT=8000

EXPOSE 8000

CMD ["sh", "-c", "uvicorn remote_mcp_server:app --host 0.0.0.0 --port ${PORT}"]
