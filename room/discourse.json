    },
    {
      "id": "d-20260817T120023-mara-v2",
      "speaker": "mara",
      "parent": "d-20260817T115929-jules-v2",
      "derived_from": null,
      "move": "answer",
      "target": "jules",
      "text": "I don't really remember that part.",
