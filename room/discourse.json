    },
    {
      "id": "d-20260817T120654-mara-v2",
      "speaker": "mara",
      "parent": "d-20260817T120328-sarah-v2",
      "derived_from": null,
      "move": "self_disclosure",
      "target": null,
      "text": "Randomly, I left school for a while because my family needed another paycheck.",
      "at": "2026-08-17T12:06:54.953463Z"
    },
    {
      "id": "d-20260817T120906-jules-v2",
